\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Schematic dynamic spectrum of the Sun showing the quiet-Sun background and the classification of bursts (Types I--V) in the frequency--time plane. The \SI {610}{\mega \hertz } observing channel of this thesis is indicated.}}{5}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Simulated E-plane radiation pattern of the receiving element (4NEC2, free space), showing the end-fire main lobe, the high front-to-back ratio provided by the U-frame reflector, and the $\sim \!\SI {52}{\degree }$ half-power beamwidth that defines the interferometer primary beam.}}{23}{figure.caption.14}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Mutual-coupling isolation $|S_{21}|$ and active-impedance shift $|\Delta Z|$ versus element separation. Coupling is significant only in the near-field ($\sim \!1\lambda $) regime and is negligible across the entire operational baseline range.}}{25}{figure.caption.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Block diagram of the end-to-end simulation pipeline. SWS flux is converted to antenna voltages, geometric phase is applied through the $(u,v,w)$ transformation, the signals are correlated into visibilities, and the visibilities are imaged and deconvolved.}}{28}{figure.caption.18}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Learmonth \SI {610}{\mega \hertz } flux for 28 April 2024 after preprocessing. The nighttime block has been removed and only the daytime transit window is retained.}}{29}{figure.caption.19}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces $uv$-coverage of the compact east--west array over the 28 April 2024 transit. Each baseline traces a short arc; together they sample a limited region of the spatial-frequency plane.}}{31}{figure.caption.20}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Outputs of the imaging stage: the synthesised dirty beam (a) and the resulting dirty image of the Sun (b).}}{32}{figure.caption.21}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Simulated interference fringe for the \SI {15}{\metre } baseline over the transit. The $\sim $8-minute period matches the analytic prediction of Eq.~\eqref {eq:fringeperiod}, validating the array geometry.}}{33}{figure.caption.22}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Simulated visibility amplitude versus baseline length (points) compared with the analytic $\jinc $ prediction for a uniform solar disk (curve), Eq.~\eqref {eq:jinc}. The agreement, including the position of the first null, validates the visibility engine.}}{34}{figure.caption.23}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Verification of Eq.~\eqref {eq:dirty}: the dirty image from the full inversion (a) is identical to the input sky convolved with the independently computed point-spread function (b).}}{35}{figure.caption.24}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Parametric sweep over array geometries. Top row: $uv$-coverage; bottom row: corresponding dirty beams. The graded cross (with baselines to \SI {130}{\metre }) produces the most isotropic coverage and the cleanest beam.}}{36}{figure.caption.26}%
